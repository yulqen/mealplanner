# Production environment variables for Meal Planner
# Copy this file to /var/www/mealplanner/.env and fill in the values

# SECURITY: Generate a new secret key for production
# Run: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=your-secret-key-here

# Set to False in production
DJANGO_DEBUG=False

# Your domain name (comma-separated if multiple)
DJANGO_ALLOWED_HOSTS=mealplanner.matthewlemon.com

# --- Phase 1D: API docs exposure ---
# Keep false on public production endpoints
DJANGO_ENABLE_API_DOCS=False

# --- Phase 1E: API throttling (optional overrides) ---
# DRF_THROTTLE_ANON=120/min
# DRF_THROTTLE_USER=600/min
# DRF_THROTTLE_TOKEN_OBTAIN=10/min
# DRF_THROTTLE_TOKEN_REFRESH=30/min
# DRF_THROTTLE_TOKEN_VERIFY=60/min

# --- Phase 2: transport/cookie hardening ---
# Enable secure cookies and SSL redirect in production.
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_SSL_REDIRECT=True

# HSTS: start lower if cautious (e.g. 3600), then raise to 31536000 once confirmed.
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=False

# Clickjacking protection (`DENY` recommended)
DJANGO_X_FRAME_OPTIONS=DENY
